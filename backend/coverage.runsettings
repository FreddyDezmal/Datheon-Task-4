<?xml version="1.0" encoding="utf-8"?>
<!--
  Code coverage for the backend, using the Microsoft collector that ships with Microsoft.NET.Test.Sdk
  (no extra package). The commands that use this file are in Documentation/Testing.md.
  (XML comments cannot contain two hyphens in a row, so command-line options aren't quoted here.)

  What is measured: the API assembly only (Storefront.Api.dll), not the tests.
  What is excluded, and why:
    - Data/Migrations/*: generated by `dotnet ef migrations add`; checked instead by the
      Migrations_match_the_model test.
    - Source-generated code ([GeneratedCode], files under obj/): e.g. the generated regex for
      idempotency keys. Not hand-written, so not a meaningful target.
  Deliberately NOT excluded: [CompilerGenerated]. The compiler puts the bodies of async methods and
  lambdas in generated classes, so excluding it would silently drop most of the checkout code.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <CodeCoverage>
            <ModulePaths>
              <Include>
                <ModulePath>.*Storefront\.Api\.dll$</ModulePath>
              </Include>
              <Exclude>
                <ModulePath>.*Storefront\.Api\.Tests\.dll$</ModulePath>
              </Exclude>
            </ModulePaths>
            <Sources>
              <Exclude>
                <Source>.*[\\/]Migrations[\\/].*</Source>
                <Source>.*[\\/]obj[\\/].*</Source>
              </Exclude>
            </Sources>
            <Attributes>
              <Exclude>
                <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
                <Attribute>^System\.Diagnostics\.CodeAnalysis\.ExcludeFromCodeCoverageAttribute$</Attribute>
              </Exclude>
            </Attributes>
          </CodeCoverage>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
