# Copy to .env.local and adjust. Vite only exposes variables prefixed with VITE_.
# Never put secrets here: everything in VITE_* ends up in the browser bundle.

# Base URL of the ASP.NET Core API (no trailing slash).
# If unset, `npm run dev` uses http://localhost:5080 and a production build calls the API on the
# same origin as the site (/api/...), so set this when the API is hosted elsewhere.
VITE_API_BASE_URL=http://localhost:5080

# Fallback display settings used until /api/store/config has loaded.
VITE_DEFAULT_CURRENCY=USD
VITE_DEFAULT_LOCALE=en-US
